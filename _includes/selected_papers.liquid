<div class="publications">
  <section class="publication-category" aria-labelledby="selected-tech-papers">
    <h3 id="selected-tech-papers" class="publication-category-title">Tech Papers</h3>
    {% bibliography --group_by none --query @*[selected=true && paper_type=tech]* %}
  </section>

  <section class="publication-category" aria-labelledby="selected-art-hci-papers">
    <h3 id="selected-art-hci-papers" class="publication-category-title">ART &amp; HCI Papers</h3>
    {% bibliography --group_by none --query @*[selected=true && paper_type=art_hci]* %}
  </section>
</div>
